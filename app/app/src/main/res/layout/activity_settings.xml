<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оформление"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Темная тема"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/theme_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Настройки libVLC"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Режим загрузки контента"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/content_load_mode_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Авто: локальный файл → локальный кэш → прямой поток при fallback"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Режим декодера"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/decoder_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/catch_up_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Догонка кадров"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/avcodec_fast_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Быстрый декодер"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Пропуск loop-фильтра"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/skip_loop_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Network caching, мс"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/network_caching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="File caching, мс"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/file_caching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Local cache, мс"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/local_caching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Дозагрузка: потоки текущей серии"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/playback_cache_threads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Предзагрузка: потоки очереди"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/playback_prefetch_threads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="По умолчанию: 8 для текущей серии, 3 для предзагрузки. Общий лимит приложения — 20 соединений."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/reset_libvlc_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Сбросить настройки libVLC и кэша" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
