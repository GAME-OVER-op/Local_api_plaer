<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/bg" android:focusableInTouchMode="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal"
        android:background="@color/surface" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="10dp">
        <Button android:id="@+id/servers_btn" style="@style/BrowserButton" android:layout_width="44dp"
            android:layout_height="44dp" android:text="‹" android:textSize="26sp" android:contentDescription="К серверам" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginLeft="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Медиатека"
                android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:id="@+id/server_status" android:layout_width="match_parent" android:layout_height="24dp"
                android:text="Подключение…" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/downloads_btn" style="@style/BrowserButton" android:layout_width="44dp"
            android:layout_height="44dp" android:contentDescription="Загрузки" app:srcCompat="@drawable/ic_download" app:tint="@color/primary" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/browser_search_bg" android:hint="Поиск в папке и подпапках" android:imeOptions="actionSearch"
            android:inputType="text" android:singleLine="true" android:paddingLeft="14dp" android:paddingRight="12dp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" />
        <Button android:id="@+id/search_btn" style="@style/BrowserButton" android:layout_width="64dp" android:layout_height="44dp"
            android:layout_marginLeft="8dp" android:text="Найти" android:textSize="12sp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none" android:fillViewport="true">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp">
            <Button android:id="@+id/view_mode_btn" style="@style/BrowserButton" android:layout_width="44dp" android:layout_height="40dp"
                android:text="▦" android:textSize="19sp" android:contentDescription="Вид файлов" />
            <Button android:id="@+id/bookmarks_btn" style="@style/BrowserButton" android:layout_width="44dp" android:layout_height="40dp"
                android:layout_marginLeft="7dp" android:text="☆" android:textSize="21sp" android:contentDescription="Закладки" />
            <Button android:id="@+id/queue_btn" style="@style/BrowserButton" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginLeft="7dp" android:text="Очередь" android:textSize="12sp" />
            <Button android:id="@+id/sort_btn" style="@style/BrowserButton" android:layout_width="58dp" android:layout_height="40dp"
                android:layout_marginLeft="7dp" android:text="A↑" android:textSize="13sp" android:contentDescription="Сортировка" />
        </LinearLayout>
    </HorizontalScrollView>
    <HorizontalScrollView android:id="@+id/crumb_scroll" android:layout_width="match_parent" android:layout_height="48dp"
        android:scrollbars="none" android:fillViewport="false">
        <LinearLayout android:id="@+id/crumbs" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="10dp" />
    </HorizontalScrollView>
    <TextView android:id="@+id/browser_summary" android:layout_width="match_parent" android:layout_height="26dp"
        android:paddingLeft="16dp" android:gravity="center_vertical" android:text="Загрузка…" android:textSize="11sp" android:textColor="@color/text_secondary" />
    <FrameLayout android:id="@+id/browse_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/browser_surface" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="4dp" android:paddingBottom="12dp"
                        android:clipToPadding="false" android:divider="@android:color/transparent" android:dividerHeight="7dp"
                        android:drawSelectorOnTop="false" android:listSelector="@android:color/transparent" />
                    <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:numColumns="auto_fit" android:columnWidth="148dp" android:horizontalSpacing="8dp" android:verticalSpacing="8dp"
                        android:padding="12dp" android:clipToPadding="false" android:stretchMode="columnWidth"
                        android:listSelector="@android:color/transparent" android:visibility="gone" />
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <LinearLayout android:id="@+id/skeleton" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:padding="16dp" android:background="@color/bg" android:visibility="gone" />
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                android:padding="28dp" android:gravity="center" android:text="Здесь пока нет файлов\nПотяните вниз, чтобы обновить"
                android:textColor="@color/text_secondary" android:textSize="15sp" android:visibility="gone" />
            <View android:id="@+id/scroll_thumb" android:layout_width="3dp" android:layout_height="48dp" android:layout_gravity="right|top"
                android:layout_marginRight="2dp" android:background="@color/scroll_thumb" android:visibility="gone" />
            <Button android:id="@+id/to_top" style="@style/BrowserButton" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="right|bottom" android:layout_margin="16dp" android:background="@drawable/btn_primary"
                android:text="↑" android:textColor="#FFFFFF" android:textSize="22sp" android:contentDescription="В начало списка" android:visibility="gone" />
        </FrameLayout>
        <View android:id="@+id/drawer_scrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#55000000" android:clickable="true" android:visibility="gone" />
        <LinearLayout android:id="@+id/right_drawer" android:layout_width="320dp" android:layout_height="match_parent"
            android:layout_gravity="right" android:orientation="vertical" android:background="@drawable/drawer_bg" android:padding="14dp" android:visibility="invisible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <TextView android:id="@+id/drawer_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:gravity="center_vertical" android:text="Закладки" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <Button android:id="@+id/drawer_close" style="@style/BrowserButton" android:layout_width="40dp" android:layout_height="40dp"
                    android:text="×" android:textSize="22sp" android:contentDescription="Закрыть панель" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bookmarks_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/BrowserSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ЗАКЛАДКИ" />
                <ListView android:id="@+id/bookmarks_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
                <TextView style="@style/BrowserSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="НЕДАВНИЕ ПАПКИ" />
                <ListView android:id="@+id/recent_dirs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
                <TextView style="@style/BrowserSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="НЕДАВНИЕ ВИДЕО" />
                <ListView android:id="@+id/recent_videos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
            </LinearLayout>
            <ScrollView android:id="@+id/info_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
                    <TextView android:id="@+id/info_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:id="@+id/info_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <TextView android:id="@+id/info_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/browser_search_bg" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <Button android:id="@+id/info_play" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:text="▶ Смотреть" />
                    <Button android:id="@+id/info_download" style="@style/BrowserButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Скачать" />
                    <Button android:id="@+id/info_install" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Скачать и установить" android:visibility="gone" />
                    <Button android:id="@+id/info_location" style="@style/BrowserButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Открыть расположение" android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/download_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/surface_alt" android:gravity="center_vertical" android:padding="12dp" android:visibility="gone">
        <TextView android:id="@+id/download_bar_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Загрузки" android:textColor="@color/text_primary" android:textSize="12sp" />
        <ProgressBar android:id="@+id/download_bar_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="96dp" android:layout_height="4dp" android:max="100" />
    </LinearLayout>
    <LinearLayout android:id="@+id/undo_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="#2B333B" android:gravity="center_vertical" android:padding="10dp" android:visibility="gone">
        <TextView android:id="@+id/undo_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="middle" android:text="Загрузка…" android:textColor="#FFFFFF" android:textSize="13sp" />
        <Button android:id="@+id/undo_cancel" style="@style/ControlButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Отменить" android:textColor="@color/accent" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/queue_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@color/surface_alt" android:gravity="center_vertical" android:padding="10dp" android:visibility="gone">
        <TextView android:id="@+id/queue_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="В очереди: 0" android:textColor="@color/text_primary" android:textSize="13sp" />
        <Button android:id="@+id/queue_clear" style="@style/BrowserButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Очистить" android:textSize="12sp" />
        <Button android:id="@+id/queue_play" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginLeft="8dp" android:text="▶ Играть" android:minWidth="70dp" android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
