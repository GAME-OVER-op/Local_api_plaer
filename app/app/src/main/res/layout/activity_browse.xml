<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main"
    android:focusableInTouchMode="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@drawable/top_bar_bg"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="14dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/servers_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="К серверам"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/primary" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Медиатека"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/server_status"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:text="Подключение…"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/downloads_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/icon_button_bg"
            android:padding="10dp"
            android:contentDescription="Загрузки"
            app:srcCompat="@drawable/ic_download"
            app:tint="@color/primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/browser_search_bg"
                android:hint="Поиск в папке и подпапках"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:paddingLeft="15dp"
                android:paddingRight="13dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/search_btn"
                style="@style/PrimaryButton"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:minHeight="0dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="Найти"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button android:id="@+id/view_mode_btn" style="@style/BrowserButton" android:layout_width="46dp" android:layout_height="42dp" android:text="▦" android:textSize="19sp" android:contentDescription="Вид файлов" />
                <Button android:id="@+id/bookmarks_btn" style="@style/BrowserButton" android:layout_width="46dp" android:layout_height="42dp" android:layout_marginLeft="7dp" android:text="☆" android:textSize="21sp" android:contentDescription="Закладки" />
                <Button android:id="@+id/queue_btn" style="@style/BrowserButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginLeft="7dp" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="Очередь" android:textSize="12sp" />
                <Button android:id="@+id/sort_btn" style="@style/BrowserButton" android:layout_width="62dp" android:layout_height="42dp" android:layout_marginLeft="7dp" android:text="A↑" android:textSize="13sp" android:contentDescription="Сортировка" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/crumb_scroll"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:scrollbars="none"
        android:fillViewport="false">
        <LinearLayout
            android:id="@+id/crumbs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/browser_summary"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical"
        android:text="Загрузка…"
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />

    <FrameLayout
        android:id="@+id/browse_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/browser_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ListView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="16dp"
                        android:clipToPadding="false"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="8dp"
                        android:drawSelectorOnTop="false"
                        android:listSelector="@android:color/transparent" />
                    <GridView
                        android:id="@+id/grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:numColumns="auto_fit"
                        android:columnWidth="156dp"
                        android:horizontalSpacing="9dp"
                        android:verticalSpacing="9dp"
                        android:padding="12dp"
                        android:clipToPadding="false"
                        android:stretchMode="columnWidth"
                        android:listSelector="@android:color/transparent"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/bg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/empty"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:padding="24dp"
                android:visibility="gone">
                <TextView android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:background="@drawable/primary_circle_bg" android:text="⌁" android:textColor="@color/primary" android:textSize="28sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Здесь пока пусто" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Потяните вниз, чтобы обновить содержимое папки." android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <View android:id="@+id/scroll_thumb" android:layout_width="3dp" android:layout_height="48dp" android:layout_gravity="right|top" android:layout_marginRight="2dp" android:background="@color/scroll_thumb" android:visibility="gone" />
            <Button android:id="@+id/to_top" style="@style/PrimaryButton" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="right|bottom" android:layout_margin="16dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="↑" android:textColor="#FFFFFF" android:textSize="22sp" android:contentDescription="В начало списка" android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:clickable="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/right_drawer"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:orientation="vertical"
            android:background="@drawable/drawer_bg"
            android:padding="16dp"
            android:visibility="invisible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
                <TextView android:id="@+id/drawer_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Закладки" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/drawer_close" style="@style/IconButton" android:layout_width="42dp" android:layout_height="42dp" android:text="×" android:textSize="22sp" android:contentDescription="Закрыть панель" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bookmarks_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/BrowserSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ЗАКЛАДКИ" />
                <ListView android:id="@+id/bookmarks_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
                <TextView style="@style/BrowserSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="НЕДАВНИЕ ПАПКИ" />
                <ListView android:id="@+id/recent_dirs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
                <TextView style="@style/BrowserSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="НЕДАВНИЕ ВИДЕО" />
                <ListView android:id="@+id/recent_videos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
            </LinearLayout>
            <ScrollView android:id="@+id/info_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
                    <TextView android:id="@+id/info_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/info_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <TextView android:id="@+id/info_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_soft_bg" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <Button android:id="@+id/info_play" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:text="Смотреть" />
                    <Button android:id="@+id/info_download" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Скачать" />
                    <Button android:id="@+id/info_install" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Скачать и установить" android:visibility="gone" />
                    <Button android:id="@+id/info_location" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Открыть расположение" android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/download_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_alt"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <TextView android:id="@+id/download_bar_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Загрузки" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/download_bar_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="104dp" android:layout_height="4dp" android:max="100" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/undo_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/player_glass_strong"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">
        <TextView android:id="@+id/undo_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="middle" android:text="Загрузка…" android:textColor="#FFFFFF" android:textSize="13sp" />
        <Button android:id="@+id/undo_cancel" style="@style/ControlButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp" android:text="Отменить" android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/queue_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">
        <TextView android:id="@+id/queue_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="В очереди: 0" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
        <Button android:id="@+id/queue_clear" style="@style/BrowserButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Очистить" android:textSize="12sp" />
        <Button android:id="@+id/queue_play" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginLeft="8dp" android:minHeight="0dp" android:minWidth="76dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="Играть" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
