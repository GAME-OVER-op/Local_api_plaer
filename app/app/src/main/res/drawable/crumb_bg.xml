<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent_soft"/><stroke android:width="1dp" android:color="@color/primary"/><corners android:radius="9dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface_alt"/><stroke android:width="1dp" android:color="@color/divider"/><corners android:radius="9dp"/></shape>
    </item>
</selector>
