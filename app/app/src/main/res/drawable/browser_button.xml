<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/list_pressed"/><stroke android:width="1dp" android:color="@color/primary"/><corners android:radius="15dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/primary_soft"/><stroke android:width="1dp" android:color="@color/primary"/><corners android:radius="15dp"/></shape></item>
    <item><shape><solid android:color="@color/surface_alt"/><corners android:radius="15dp"/></shape></item>
</selector>
